# Nexora cloud sync (Supabase) — optional.
# Without these, the app runs 100% local (current behavior).
# With these set (and the two GitHub secrets below), users sign in
# with email + password and their data syncs across devices.
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# GitHub Pages deploy: repo Settings → Secrets and variables → Actions → add:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
# Then push — the workflow injects them at build time.
